---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { slugifyStr } from "@/utils/slugify";
import { getEntryPath, getGallerySlug } from "@/utils/contentEntry";
import { getReadingTime } from "@/utils/readingTime";
import Datetime from "./Datetime.astro";
import IconGallery from "@/assets/icons/IconGallery.svg";
import IconClock from "@/assets/icons/IconClock.svg";
import { SITE } from "@/config";

type Props = {
  variant?: "h2" | "h3";
  featured?: boolean;
  loading?: "lazy" | "eager";
  fetchpriority?: "auto" | "high" | "low";
} & (CollectionEntry<"blog"> | CollectionEntry<"blogEn"> | CollectionEntry<"galleries">);

const {
  variant: Heading = "h2",
  featured = false,
  loading = "lazy",
  fetchpriority,
  id,
  data,
  filePath,
  collection,
  body,
} = Astro.props;

const { title, description, pubDatetime } = data;
const modDatetime = "modDatetime" in data ? data.modDatetime : null;
const timezone = "timezone" in data ? data.timezone : undefined;
const tags = "tags" in data ? data.tags : [];
const href = getEntryPath({ collection, id, filePath });
const isGallery = collection === "galleries";
const headingId = `${collection}-${slugifyStr(String(id))}-title`;
const descriptionId = `${collection}-${slugifyStr(String(id))}-description`;
const viewTransitionName = slugifyStr(String(title).replaceAll(".", "-"));
const readingTime = body ? getReadingTime(body) : null;

// Resolve cover image source
let coverSrc: string | ImageMetadata | undefined;
if (SITE.showCoverImages) {
  if (isGallery) {
    // Galleries: prefer coverImage from frontmatter, fallback to first folder image
    const coverImage = (data as { coverImage?: ImageMetadata }).coverImage;
    if (coverImage) {
      coverSrc = coverImage;
    } else {
      // Load all gallery images at build-time (same pattern as galleries/index.astro)
      const allGalleryImages = import.meta.glob<{ default: ImageMetadata }>(
        "/src/data/galleries/**/*.{jpg,jpeg,png,webp,avif,gif,JPG,JPEG,PNG,WEBP}",
        { eager: true }
      );
      const gallerySlug = getGallerySlug(id);
      const firstImage = Object.entries(allGalleryImages)
        .filter(([path]) => path.startsWith(`/src/data/galleries/${gallerySlug}/`))
        .sort(([a], [b]) => a.localeCompare(b))
        .at(0)?.[1]?.default;
      if (firstImage) {
        coverSrc = firstImage;
      }
    }
  } else {
    // Blog posts: prefer frontmatter coverImage, then ogImage, fallback to dynamic OG image
    const coverImage = (data as { coverImage?: ImageMetadata }).coverImage;
    const ogImage = "ogImage" in data ? data.ogImage : undefined;

    if (coverImage) {
      coverSrc = coverImage;
    } else if (ogImage) {
      coverSrc = ogImage;
    } else if (SITE.dynamicOgImage) {
      // Fallback: dynamically generated OG image (exists in dist/ after pnpm build)
      coverSrc = `${href}/index.png`;
    }
  }
}
---

<li
  class:list={[
    "card-glow group/card relative my-3 rounded-2xl flex flex-col justify-between",
    // Use overflow-hidden when cover image is shown so the image respects border-radius
    coverSrc ? "overflow-hidden" : "",
    "border backdrop-blur-sm",
    "transition-[border-color,background-color,box-shadow,transform] duration-300 ease-out motion-reduce:transform-none motion-reduce:transition-none",
    "hover:-translate-y-0.5 focus-within:-translate-y-0.5",
    "hover:shadow-lg focus-within:shadow-lg",

    // Default posts styling
    !isGallery && !featured && [
      "border-border/20 bg-muted/10",
      "hover:border-accent/40 hover:bg-accent/5 focus-within:border-accent/40 focus-within:bg-accent/5",
      "hover:shadow-accent/10 focus-within:shadow-accent/10",
    ],

    // Featured generic posts styling
    !isGallery && featured && [
      "border-accent/40 bg-accent/8",
      "hover:border-accent/40 hover:bg-accent/15 focus-within:border-accent/40 focus-within:bg-accent/15",
      "hover:shadow-accent/20 focus-within:shadow-accent/20",
      "shadow-[0_0_25px_-5px_color-mix(in_srgb,var(--accent)_20%,transparent)]",
    ],

    // Gallery variant styling
    isGallery && !featured && [
      "border-purple-500/20 bg-purple-500/5",
      "hover:border-purple-500/40 hover:bg-purple-500/10 focus-within:border-purple-500/40 focus-within:bg-purple-500/10",
      "hover:shadow-purple-500/10 focus-within:shadow-purple-500/10",
    ],

    // Featured gallery styling
    isGallery && featured && [
      "border-purple-500/40 bg-purple-500/10",
      "hover:border-purple-500/60 hover:bg-purple-500/15 focus-within:border-purple-500/60 focus-within:bg-purple-500/15",
      "hover:shadow-purple-500/20 focus-within:shadow-purple-500/20",
      "shadow-[0_0_20px_-5px_rgba(168,85,247,0.15)]",
    ],
  ]}
>
  <!-- Cursor-following glow -->
  <div
    class="card-glow-effect pointer-events-none absolute inset-0 z-0 rounded-2xl opacity-0 transition-opacity duration-300 motion-reduce:transition-none group-hover/card:opacity-100 group-focus-within/card:opacity-100"
    aria-hidden="true"
  >
  </div>

  <!-- Cover image — wrapped in <a> for clickability; aria-hidden so screen readers skip the duplicate link -->
  {coverSrc && (
    <a href={href} tabindex="-1" aria-hidden="true" class="card-cover-wrapper block" data-cover>
      {typeof coverSrc === "object" ? (
        <Image
          src={coverSrc}
          alt={title}
          class="card-cover-img"
          loading={loading}
          fetchpriority={fetchpriority}
          widths={[400, 800]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        />
      ) : (
        <img
          src={coverSrc}
          alt={title}
          class="card-cover-img"
          loading={loading}
          fetchpriority={fetchpriority}
          decoding="async"
          width="1200"
          height="630"
          onerror="this.closest('[data-cover]').style.display='none'"
        />
      )}
      <div class="card-cover-overlay" aria-hidden="true"></div>
    </a>
  )}

  <div class="relative z-5 p-5 flex flex-col flex-1 justify-between">
    <div>
      <a
        href={href}
        class:list={[
          "text-lg font-bold tracking-tight text-foreground transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-sm block",
          isGallery 
            ? "group-hover/card:text-purple-400 focus-visible:ring-purple-500" 
            : featured 
              ? "group-hover/card:text-amber-500 focus-visible:ring-amber-500"
              : "group-hover/card:text-accent focus-visible:ring-accent"
        ]}
        aria-labelledby={headingId}
        aria-describedby={descriptionId}
        style={{ viewTransitionName }}
      >
        <Heading id={headingId} class="flex items-center gap-2">
          {isGallery && (
            <span
              aria-hidden="true"
              class="inline-flex items-center justify-center rounded-md bg-purple-500/10 p-1 text-purple-400/80 ring-1 ring-purple-500/20"
            >
              <IconGallery class="size-4" />
            </span>
          )}
          {isGallery && <span class="sr-only">Gallery:</span>}
          {title}
        </Heading>
        <!-- Expand clickable area to whole card on top of everything, minus the description -->
        <span class="absolute -inset-5 z-10" aria-hidden="true"></span>
      </a>
      
      <!-- Meta row: date + reading time -->
      <div class="relative z-20 mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 pointer-events-none text-xs text-foreground/65">
        <Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} timezone={timezone} />
        {readingTime && (
          <span class="flex items-center gap-1 text-xs text-foreground/65 whitespace-nowrap">
            <IconClock class="size-3.5 shrink-0" aria-hidden="true" />
            {readingTime}
          </span>
        )}
      </div>

      <p
        id={descriptionId}
        class="relative z-20 mt-3 line-clamp-3 text-sm leading-relaxed text-foreground/80 pointer-events-auto select-text"
      >
        {description}
      </p>
    </div>

    <!-- Tags & Arrow Row -->
    <div class="relative z-20 mt-5 pt-3.5 border-t border-border/20 flex items-center justify-between gap-2 pointer-events-auto">
      {SITE.showTagsInCards && tags.length > 0 ? (
        <ul class="flex flex-wrap gap-1.5">
          {tags.slice(0, 3).map((tag: string) => (
            <li>
              <a
                href={`/tags/${slugifyStr(tag)}/`}
                class:list={[
                  "inline-flex items-center gap-0.5 rounded-full px-2 py-0.5",
                  "text-xs font-medium font-firacode",
                  "border transition-colors duration-200",
                  isGallery
                    ? "border-purple-500/25 bg-purple-500/8 text-purple-400/80 hover:border-purple-500/50 hover:bg-purple-500/15 hover:text-purple-400"
                    : featured
                      ? "border-amber-500/25 bg-amber-500/8 text-amber-500/80 hover:border-amber-500/50 hover:bg-amber-500/15 hover:text-amber-500"
                      : "border-border/30 bg-muted/20 text-foreground/65 hover:border-accent/40 hover:bg-accent/10 hover:text-accent",
                ]}
              >
                <span aria-hidden="true" class="opacity-60">#</span>{tag}
              </a>
            </li>
          ))}
        </ul>
      ) : <div />}

      <span class="text-xs font-semibold text-accent/80 group-hover/card:text-accent flex items-center gap-1 transition-colors shrink-0">
        <span>Leggi</span>
        <span class="transition-transform group-hover/card:translate-x-0.5">→</span>
      </span>
    </div>
  </div>
</li>

<style>
  .card-glow {
    contain: paint;
  }

  .card-glow-effect {
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      color-mix(in oklab, var(--accent) 8%, transparent) 0%,
      color-mix(in oklab, var(--accent) 4%, transparent) 30%,
      color-mix(in oklab, var(--accent) 0.8%, transparent) 60%,
      transparent 80%
    );
    will-change: opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-glow-effect {
      background: none;
    }
  }

  /* ── Cover image ── */
  .card-cover-wrapper {
    position: relative;
    width: 100%;
    /* 1200/630 OG aspect ratio */
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    /* Clamp height so tall viewports don't blow up the card */
    max-height: 220px;
  }

  .card-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    /* Subtle zoom on hover via the parent group */
    transition: transform 0.4s ease, filter 0.4s ease;
    filter: brightness(0.95) saturate(1.05);
  }

  :global(.group\/card:hover) .card-cover-img,
  :global(.group\/card:focus-within) .card-cover-img {
    transform: scale(1.03);
    filter: brightness(1) saturate(1.1);
  }

  /* Fade-to-card-background gradient at the bottom of the cover */
  .card-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      color-mix(in oklab, var(--background) 60%, transparent) 100%
    );
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-cover-img {
      transition: none;
    }
  }
</style>
