---
import type { HTMLAttributes } from "astro/types";
import { getCollection } from "astro:content";
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import Logo from "./Logo.astro";
import IconRss from "@/assets/icons/IconRss.svg";
import { getLangFromUrl, useTranslations, getAlternateUrl, localePath } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();
const projectsBase = lang === "en" ? "/en/projects" : "/progetti";

// Latest apps, same order as the "Ultimi progetti" list on the home page
const projects = await getCollection(lang === "en" ? "projectsEn" : "projects", ({ data }) => !data.draft);
const latestProjects = projects
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime())
  .slice(0, 4);

const exploreLinks = [
  { href: localePath(lang, "/"), label: t("nav.home") },
  { href: projectsBase, label: t("nav.projects") },
  { href: localePath(lang, "/docs"), label: t("footer.docs") },
  { href: localePath(lang, "/posts"), label: t("nav.posts") },
  { href: localePath(lang, "/about"), label: t("nav.about") },
];

const resourceLinks = [
  ...(SITE.showArchives ? [{ href: localePath(lang, "/archives"), label: t("nav.archives") }] : []),
  { href: localePath(lang, "/tags"), label: t("nav.tags") },
  { href: localePath(lang, "/search"), label: t("nav.search") },
];

// Localized labels for the profile icons (SOCIALS titles are English-only)
const socialLabels: Record<string, string> = {
  GitHub: t("footer.github"),
  Mail: t("footer.mail"),
};

const socialLinks = SOCIALS.map(social => ({
  ...social,
  label: socialLabels[social.name] ?? social.linkTitle,
  isExternal: /^https?:\/\//.test(social.href),
}));

const alternateLang = lang === "it" ? "en" : "it";
const alternateUrl = getAlternateUrl(Astro.url, alternateLang);

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["footer-wrapper", { "mt-auto": !noMarginTop }, className]}
  role="contentinfo"
  {...attrs}
>
  <!-- Top gradient border -->
  <div
    class="h-px w-full bg-linear-to-r from-transparent via-border/40 to-transparent"
  >
  </div>

  <div class="app-layout py-10 sm:py-12">
    <div class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-[1.6fr_1fr_1fr_1fr] md:gap-10">
      <!-- Brand column -->
      <div class="col-span-2 flex flex-col gap-3 md:col-span-1">
        <a
          href={localePath(lang, "/")}
          aria-label={t("footer.home_label")}
          class="group footer-home-link relative flex w-fit items-center gap-2 rounded-md text-lg font-bold tracking-tight"
        >
          <Logo class="text-lg opacity-80 transition-all duration-300 group-hover:opacity-100" />
          <span class="sr-only">{SITE.title}</span>
        </a>
        <p class="max-w-xs text-sm leading-relaxed text-foreground/65">
          {t("footer.tagline")}
        </p>
        <ul class="mt-1 flex items-center gap-2" role="list">
          {
            socialLinks.map(social => (
              <li>
                <LinkButton
                  href={social.href}
                  target={social.isExternal ? "_blank" : undefined}
                  rel={social.isExternal ? "noopener noreferrer" : undefined}
                  aria-label={social.label}
                  class="footer-icon-btn group"
                  title={social.label}
                >
                  <social.icon class="size-4.5 fill-transparent stroke-foreground/60 stroke-[1.5px] transition-colors duration-200 group-hover:stroke-accent" />
                  <span class="sr-only">{social.label}</span>
                </LinkButton>
              </li>
            ))
          }
          <li>
            <a
              href="/rss.xml"
              target="_blank"
              aria-label={t("footer.rss")}
              title={t("footer.rss")}
              class="footer-icon-btn group"
            >
              <IconRss class="size-4.5 stroke-foreground/60 stroke-[1.5px] transition-colors duration-200 group-hover:stroke-accent" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Link columns: hidden on phones, where the header menu covers the same pages -->
      <!-- Explore -->
      <nav aria-labelledby="footer-explore-heading" class="hidden sm:block">
        <p id="footer-explore-heading" class="footer-heading">{t("footer.explore")}</p>
        <ul class="footer-list" role="list">
          {exploreLinks.map(link => <li><a href={link.href} class="footer-link">{link.label}</a></li>)}
        </ul>
      </nav>

      <!-- Latest apps -->
      <nav aria-labelledby="footer-apps-heading" class="hidden sm:block">
        <p id="footer-apps-heading" class="footer-heading">{t("footer.apps")}</p>
        <ul class="footer-list" role="list">
          {latestProjects.map(project => (
            <li><a href={`${projectsBase}/${project.id}/`} class="footer-link">{project.data.title}</a></li>
          ))}
          <li>
            <a href={projectsBase} class="footer-link footer-link--accent">
              {t("footer.all_apps")} ({projects.length}) →
            </a>
          </li>
        </ul>
      </nav>

      <!-- Resources -->
      <nav aria-labelledby="footer-resources-heading" class="hidden sm:block">
        <p id="footer-resources-heading" class="footer-heading">{t("footer.resources")}</p>
        <ul class="footer-list" role="list">
          {resourceLinks.map(link => <li><a href={link.href} class="footer-link">{link.label}</a></li>)}
          <li><a href="/rss.xml" target="_blank" class="footer-link">{t("footer.rss")}</a></li>
          <li><a href={localePath(lang, "/privacy")} class="footer-link">{t("footer.privacy")}</a></li>
        </ul>
      </nav>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 h-px w-full bg-linear-to-r from-transparent via-border/25 to-transparent" aria-hidden="true"></div>

    <div class="mt-4 flex flex-col items-center justify-between gap-3 text-center sm:flex-row sm:text-start">
      <p class="font-firacode text-xs tracking-wide text-foreground/45">
        &copy; {currentYear} {SITE.title}. {t("footer.rights")}
      </p>
      <p class="inline-flex items-center gap-1.5 text-xs text-foreground/55">
        <span class="size-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
        {t("footer.no_tracking")}
      </p>
      <p class="font-firacode text-xs tracking-wide text-foreground/45">
        <span class="text-foreground/80" aria-current="true">{lang.toUpperCase()}</span>
        <span aria-hidden="true"> · </span>
        <a
          href={alternateUrl}
          hreflang={alternateLang}
          lang={alternateLang}
          class="transition-colors duration-200 hover:text-accent"
          aria-label={t("footer.switch_lang")}
        >{alternateLang.toUpperCase()}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    position: relative;
    isolation: isolate;
    /* Soft gradient descending to bottom */
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--background) 30%, transparent),
      color-mix(in srgb, var(--background) 80%, transparent) 80%
    );
  }

  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .footer-wrapper {
      backdrop-filter: blur(12px) saturate(140%);
      -webkit-backdrop-filter: blur(12px) saturate(140%);
    }
  }

  .footer-home-link {
    outline-offset: 4px;
  }

  .footer-heading {
    margin-bottom: 0.75rem;
    font-family: var(--font-firacode, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
    user-select: none;
  }

  .footer-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-link {
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    transition: color 0.2s ease;
  }

  .footer-link:hover,
  .footer-link:focus-visible,
  .footer-link--accent {
    color: var(--accent);
  }

  /* Same tone and hover as the site cards */
  :global(.footer-icon-btn) {
    display: flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--border) 20%, transparent);
    background: color-mix(in srgb, var(--muted) 5%, transparent);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  :global(.footer-icon-btn:hover),
  :global(.footer-icon-btn:focus-visible) {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--muted) 20%, transparent);
  }
</style>
