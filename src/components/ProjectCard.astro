---
import { getCollection, type CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

type Props = {
  project: CollectionEntry<"projects"> | CollectionEntry<"projectsEn">;
  href: string;
  lang?: "it" | "en";
  featured?: boolean;
};

const { project, href, lang = "it", featured = false } = Astro.props;
const { title, description, pubDatetime, appStore, playStore, website } = project.data;

const projectDocs = lang === "en"
  ? await getCollection("docsEn", d => !d.data.draft && (d.data.project || d.id.split("/")[0]) === project.id)
  : await getCollection("docs", d => !d.data.draft && (d.data.project || d.id.split("/")[0]) === project.id);
const hasDocs = projectDocs.length > 0;

const appStoreLabel = "App Store";
const playStoreLabel = "Google Play";
const websiteLabel = lang === "en" ? "Website" : "Sito web";

const headingId = `project-${slugifyStr(String(project.id))}-title`;
const descriptionId = `project-${slugifyStr(String(project.id))}-description`;
---

<li
  class:list={[
    "card-glow group/card relative my-3 rounded-2xl",
    "border backdrop-blur-sm",
    "transition-[border-color,background-color,box-shadow] duration-200 ease-out motion-reduce:transition-none",
    "hover:shadow-md focus-within:shadow-md",
    !featured && [
      "border-border/20 bg-muted/5",
      "hover:border-accent/40 hover:bg-muted/20 focus-within:border-accent/40 focus-within:bg-muted/20",
      "hover:shadow-accent/5 focus-within:shadow-accent/5",
    ],
    featured && [
      "border-accent/30 bg-accent/5",
      "hover:border-accent/40 hover:bg-accent/10 focus-within:border-accent/40 focus-within:bg-accent/10",
      "hover:shadow-accent/15 focus-within:shadow-accent/15",
      "shadow-[0_0_20px_-5px_color-mix(in_oklab,var(--color-accent)_15%,transparent)]",
    ],
  ]}
>
  <div class="relative z-5 p-4 sm:p-5">
    <div class="flex items-center justify-between gap-2">
      <a
        href={href}
        class="text-lg font-semibold text-foreground transition-colors duration-200 group-hover/card:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-sm"
        aria-labelledby={headingId}
        aria-describedby={descriptionId}
      >
        <h2 id={headingId}>{title}</h2>
        <span class="absolute -inset-4 sm:-inset-5 z-10" aria-hidden="true"></span>
      </a>

      {hasDocs && (
        <a
          href={lang === "en" ? `/en/projects/${project.id}/docs/` : `/progetti/${project.id}/docs/`}
          class="relative z-20 inline-flex items-center gap-1.5 rounded-full border border-accent/40 bg-accent/15 px-2.5 py-0.5 text-xs font-firacode font-medium text-accent hover:bg-accent hover:text-background transition-all shadow-sm"
          title={`${projectDocs.length} guide disponibili`}
        >
          <span>Docs</span>
          <span class="size-1 rounded-full bg-accent animate-pulse"></span>
        </a>
      )}
    </div>

    <div class="relative z-20 mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 pointer-events-none">
      <Datetime pubDatetime={pubDatetime} />
    </div>

    <p
      id={descriptionId}
      class="relative z-20 mt-2 line-clamp-2 text-sm leading-relaxed text-foreground/80 pointer-events-auto select-text"
    >
      {description}
    </p>

    {(hasDocs || appStore || playStore || website) && (
      <div class="relative z-20 mt-4 flex flex-wrap gap-2 pointer-events-auto">
        {hasDocs && (
          <a
            href={lang === "en" ? `/en/projects/${project.id}/docs/` : `/progetti/${project.id}/docs/`}
            class="inline-flex items-center gap-1.5 rounded-full border border-accent/40 bg-accent/15 px-3 py-1 text-xs font-semibold text-accent transition-all hover:bg-accent hover:text-background"
          >
            <span>Wiki & Docs</span>
            <span class="text-xs font-firacode opacity-75">({projectDocs.length})</span>
          </a>
        )}
        {appStore && (
          <a
            href={appStore}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-border/30 bg-muted/20 px-3 py-1 text-xs font-medium text-foreground/65 transition-colors hover:border-accent/40 hover:text-accent"
          >
            {appStoreLabel}
          </a>
        )}
        {playStore && (
          <a
            href={playStore}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-border/30 bg-muted/20 px-3 py-1 text-xs font-medium text-foreground/65 transition-colors hover:border-accent/40 hover:text-accent"
          >
            {playStoreLabel}
          </a>
        )}
        {website && (
          <a
            href={website}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-border/30 bg-muted/20 px-3 py-1 text-xs font-medium text-foreground/65 transition-colors hover:border-accent/40 hover:text-accent"
          >
            {websiteLabel}
          </a>
        )}
      </div>
    )}
  </div>
</li>

<style>
  .card-glow {
    contain: paint;
  }
</style>
