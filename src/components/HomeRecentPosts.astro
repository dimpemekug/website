---
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import "dayjs/locale/it";
import Card from "./Card.astro";
import { getEntryPath } from "@/utils/contentEntry";
import { getLangFromUrl } from "@/i18n/utils";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  posts: (CollectionEntry<"blog"> | CollectionEntry<"blogEn"> | CollectionEntry<"galleries">)[];
};

const { posts } = Astro.props;
const lang = getLangFromUrl(Astro.url);

// Latest post as a full card, the next ones as a compact list
const [latest, ...others] = posts;

const formatDate = (date: Date) =>
  dayjs(date).tz(SITE.timezone).locale(lang).format("D MMM YYYY");
---

{
  latest && (
    <div class="grid grid-cols-1 md:grid-cols-[1.15fr_1fr] gap-5 items-stretch">
      <ul class="[&>li]:my-0 [&>li]:h-full">
        <Card variant="h3" {...latest} loading="eager" fetchpriority="high" />
      </ul>

      {others.length > 0 && (
        <ul class="flex flex-col rounded-2xl border border-border/20 bg-muted/5 px-4 py-1 backdrop-blur-sm">
          {others.map(post => (
            <li class="border-b border-border/20 last:border-b-0">
              <a
                href={getEntryPath(post)}
                class="group/row -mx-2 flex flex-col gap-1 rounded-xl px-2 py-3.5 transition-colors duration-200 hover:bg-muted/20 sm:flex-row sm:items-baseline sm:gap-4"
              >
                <time
                  datetime={post.data.pubDatetime.toISOString()}
                  class="shrink-0 font-firacode text-xs text-foreground/50 sm:w-24"
                >
                  {formatDate(post.data.pubDatetime)}
                </time>
                <span class="text-sm font-semibold leading-snug text-foreground transition-colors group-hover/row:text-accent">
                  {post.data.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}
