---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import PageHero from "@/components/PageHero.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { SITE } from "@/config";

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());
---

<Layout title={`Progetti | ${SITE.title}`} description="App e siti web che ho sviluppato.">
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-4">
    <PageHero variant="list" eyebrow="PORTFOLIO & APPLICAZIONI NATIVE" title="Progetti">
      <Fragment slot="description">App macOS, soluzioni mobile e siti web sviluppati con attenzione alla privacy, architettura local-first e codice pulito.</Fragment>
      <Fragment slot="stats">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
          <span class="size-1.5 rounded-full bg-accent"></span>
          <span>{projects.length} Progetti pubblicati</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
          <span class="size-1.5 rounded-full bg-emerald-400"></span>
          <span>100% Sempre Gratuite</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
          <span class="size-1.5 rounded-full bg-sky-400"></span>
          <span>Zero Ads & Tracking</span>
        </span>
      </Fragment>
    </PageHero>

    {projects.length > 0 ? (
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 [&>li]:my-0">
        {projects.map(project => (
          <ProjectCard
            project={project}
            href={`/progetti/${project.id}/`}
            lang="it"
          />
        ))}
      </ul>
    ) : (
      <p class="mt-8 text-foreground/65 italic">Nessun progetto ancora. Presto in arrivo.</p>
    )}
  </main>
  <Footer />
</Layout>
