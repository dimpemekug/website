---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/config";

const allDocs = await getCollection("docs", ({ data }) => !data.draft);
const allProjects = await getCollection("projects", ({ data }) => !data.draft);

const projectMap = new Map(allProjects.map(p => [p.id, p]));

// Group docs by project
const projectsWithDocs = Array.from(
  new Set(allDocs.map(d => d.data.project || d.id.split("/")[0]))
);

const projectDocGroups = projectsWithDocs.map(projectId => {
  const project = projectMap.get(projectId);
  const docs = allDocs
    .filter(d => (d.data.project || d.id.split("/")[0]) === projectId)
    .sort((a, b) => a.data.order - b.data.order);

  return {
    id: projectId,
    title: project ? project.data.title : projectId,
    description: project ? project.data.description : "",
    tags: project ? project.data.tags : [],
    docsCount: docs.length,
    docs,
  };
});
---

<Layout
  title={`Documentazione & Wiki Progetti | ${SITE.title}`}
  description="Guide tecniche, wiki, manuali d'uso e riferimenti di configurazione per tutte le app e i progetti software."
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-20">
    <PageHero variant="list" eyebrow="KNOWLEDGE BASE & GUIDE UFFICIALI" title="Documentazione & Wiki">
      <Fragment slot="description">Manuali d'uso, guide all'installazione, riferimenti per la privacy e scorciatoie da tastiera per tutti i software e i progetti.</Fragment>
      <Fragment slot="stats">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
          <span class="size-1.5 rounded-full bg-accent"></span>
          <span>{projectsWithDocs.length} Progetti con Wiki</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
          <span class="size-1.5 rounded-full bg-emerald-400"></span>
          <span>{allDocs.length} Articoli & Guide</span>
        </span>
      </Fragment>
    </PageHero>

    <!-- Project Docs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projectDocGroups.map(p => (
        <div class="group relative rounded-2xl border border-border/20 bg-muted/10 p-6 hover:border-accent/40 hover:bg-muted/10 transition-all duration-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-2xl font-bold text-foreground group-hover:text-accent transition-colors">
                {p.title}
              </h2>
              <span class="text-xs font-firacode px-2 py-0.5 rounded-md border border-border/30 bg-muted/20 text-foreground/65">
                {p.docsCount} {p.docsCount === 1 ? "guida" : "guide"}
              </span>
            </div>

            {p.description && (
              <p class="text-sm text-foreground/65 line-clamp-3 mb-5 leading-relaxed">
                {p.description}
              </p>
            )}

            <!-- Quick list of guides -->
            <ul class="space-y-1.5 mb-6 text-xs text-foreground/65 border-t border-border/20 pt-4">
              {p.docs.slice(0, 4).map(d => {
                const docSlug = d.id === p.id || d.id === `${p.id}/index`
                  ? "index"
                  : (d.id.includes("/") ? d.id.split("/").slice(1).join("/") : d.id);
                const docHref = docSlug === "index" ? `/progetti/${p.id}/docs/` : `/progetti/${p.id}/docs/${docSlug}/`;
                return (
                  <li>
                    <a href={docHref} class="hover:text-accent flex items-center gap-1.5 transition-colors">
                      <span class="text-accent/50 font-firacode">→</span>
                      <span>{d.data.title}</span>
                    </a>
                  </li>
                );
              })}
              {p.docs.length > 4 && (
                <li class="text-xs text-foreground/45 italic">
                  + altre {p.docs.length - 4} pagine...
                </li>
              )}
            </ul>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-border/20">
            <a
              href={`/progetti/${p.id}/`}
              class="text-xs text-foreground/45 hover:text-foreground transition-colors"
            >
              Scheda app
            </a>
            <a
              href={`/progetti/${p.id}/docs/`}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline"
            >
              <span>Esplora Documentazione</span>
              <span class="font-firacode">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
