---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import PageHero from "@/components/PageHero.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import HomeRecentPosts from "@/components/HomeRecentPosts.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import IntroAudio from "@/components/IntroAudio.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const [blogPosts, galleryPosts, allProjects, allDocs] = await Promise.all([
  getCollection("blog"),
  SITE.showGalleries && SITE.showGalleriesInIndex
    ? getCollection("galleries")
    : Promise.resolve([]),
  getCollection("projects", ({ data }) => !data.draft),
  getCollection("docs", ({ data }) => !data.draft),
]);
const posts = [...blogPosts, ...galleryPosts];

const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts;

const projectsWithDocsSet = new Set(
  allDocs.map(d => d.data.project || d.id.split("/")[0])
);

// Latest 4 projects sorted by publication date
const latestProjects = [...allProjects]
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime())
  .slice(0, 4);

const pinnedProjectIds = ["rzip", "rexif", "codevault", "rmux", "netcalc", "resizo"];
const pinnedProjects = pinnedProjectIds
  .map(id => allProjects.find(project => project.id === id))
  .filter((project): project is (typeof allProjects)[number] => Boolean(project));
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index" class="relative app-layout">
    <!-- ═══════════════════ HERO ═══════════════════ -->
    <PageHero variant="landing" eyebrow="App macOS, Mobile & Soluzioni Web" class="pt-10 pb-16 sm:pt-16 sm:pb-24">
      <Fragment slot="title">
        App e siti web.<br />
        <span class="bg-gradient-to-r from-accent via-indigo-400 to-sky-400 bg-clip-text text-transparent">Codice pulito, idee chiare.</span>
      </Fragment>

      {
        SITE.introAudio.enabled && (
          <div class="mt-3">
            <IntroAudio
              src={SITE.introAudio.src}
              label={SITE.introAudio.label}
              duration={SITE.introAudio.duration}
              isStream={SITE.introAudio.isStream}
            />
          </div>
        )
      }

      <!-- Description -->
      <p
        class="mt-6 max-w-xl text-base sm:text-lg leading-relaxed text-foreground/80"
      >
        {t("home.description_intro")} {t("home.description")}
      </p>
      <p class="mt-3 max-w-xl text-sm sm:text-base leading-relaxed text-foreground/65">
        {t("home.description_blog")}
      </p>

      <!-- Linear Action CTA Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/progetti/"
          class="inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-background shadow-lg shadow-accent/25 transition-all duration-200 hover:opacity-95 hover:scale-[1.02]"
        >
          <span>Esplora Progetti</span>
          <IconArrowRight class="size-4 rtl:-rotate-180" />
        </a>
        <a
          href="/docs/"
          class="inline-flex items-center gap-2 rounded-xl border border-border/30 bg-muted/20 px-5 py-2.5 text-sm font-semibold text-foreground backdrop-blur-md transition-all duration-200 hover:border-accent/40 hover:bg-muted/20"
        >
          <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <span>Wiki & Docs</span>
        </a>
        <a
          href="/posts/"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-foreground/65 hover:text-accent transition-colors"
        >
          <span>Articoli ({posts.length}) →</span>
        </a>
      </div>

      <Fragment slot="stats">
        <span class="flex items-center gap-1.5">
          <span class="size-1.5 rounded-full bg-accent"></span>
          <span>{allProjects.length} App e Progetti</span>
        </span>
        <span class="flex items-center gap-1.5">
          <span class="size-1.5 rounded-full bg-emerald-400"></span>
          <span>Wiki & Manuali Ufficiali</span>
        </span>
        <span class="flex items-center gap-1.5">
          <span class="size-1.5 rounded-full bg-sky-400"></span>
          <span>Zero Tracciamento & Privacy</span>
        </span>
      </Fragment>

      {SOCIALS.length > 0 && (
        <div slot="footer" class="mt-6">
          <Socials />
        </div>
      )}

      <!-- Right Side: Latest Projects Card List (Linear style) -->
      <div slot="aside" class="rounded-2xl border border-border/20 bg-muted/10 p-4.5 backdrop-blur-md shadow-xl shadow-black/5">
        <div class="flex items-center justify-between mb-3.5 pb-2.5 border-b border-border/20">
          <span class="text-xs font-bold text-foreground flex items-center gap-2">
            <span class="size-2 rounded-full bg-accent animate-pulse"></span>
            <span>Ultimi Progetti</span>
          </span>
          <a
            href="/progetti/"
            class="text-xs font-firacode font-medium text-accent hover:underline flex items-center gap-1"
          >
            <span>Tutti ({allProjects.length}) →</span>
          </a>
        </div>

        <ul class="space-y-2.5">
          {latestProjects.map(project => {
            const hasDocs = projectsWithDocsSet.has(project.id);
            const tag = project.data.tags[0] ?? "macOS";
            return (
              <li class="group/item relative rounded-xl border border-border/20 bg-background/50 p-3 transition-all duration-200 hover:border-accent/40 hover:bg-muted/20 hover:shadow-md hover:shadow-accent/5">
                <div class="flex items-start justify-between gap-2">
                  <a
                    href={`/progetti/${project.id}/`}
                    class="text-sm font-bold text-foreground group-hover/item:text-accent transition-colors flex items-center gap-1.5"
                  >
                    <span>{project.data.title}</span>
                    <span class="absolute -inset-0 rounded-xl" aria-hidden="true"></span>
                  </a>

                  <div class="relative z-10 flex items-center gap-1 shrink-0">
                    {hasDocs && (
                      <a
                        href={`/progetti/${project.id}/docs/`}
                        class="inline-flex items-center gap-1 rounded-full border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-firacode text-accent hover:bg-accent hover:text-background transition-colors"
                        title="Apri documentazione"
                      >
                        <span>Docs</span>
                      </a>
                    )}
                    <span class="text-xs font-firacode px-1.5 py-0.5 rounded-md border border-border/30 bg-muted/20 text-foreground/65">
                      {tag}
                    </span>
                  </div>
                </div>

                <p class="mt-1.5 text-xs text-foreground/65 line-clamp-2 leading-relaxed">
                  {project.data.description}
                </p>
              </li>
            );
          })}
        </ul>

        <div class="mt-3.5 pt-3 border-t border-border/20 flex items-center justify-between text-xs">
          <span class="text-foreground/45 text-xs">Software nativi & utility</span>
          <a href="/docs/" class="text-xs font-medium text-accent hover:underline flex items-center gap-1">
            <span>Knowledge Base</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </PageHero>

    <!-- ═══════════════════ PROGETTI ED APP IN EVIDENZA ═══════════════════ -->
    {pinnedProjects.length > 0 && (
      <section id="projects" class="pt-6 pb-14">
        <!-- Section Header -->
        <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent/30 bg-accent/10 text-accent font-firacode text-xs font-semibold mb-2.5">
              <span>✦ SOFTWARE & APPLICAZIONI NATIVE</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
              Progetti ed App in Evidenza
            </h2>
            <p class="text-sm text-foreground/65 mt-1 max-w-xl">
              Software focalizzati su efficienza, architettura local-first e rigoroso rispetto della privacy dei dati.
            </p>
          </div>

          <a
            href="/progetti/"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline shrink-0"
          >
            <span>Tutti i progetti ({allProjects.length})</span>
            <IconArrowRight class="size-3.5 rtl:-rotate-180" />
          </a>
        </div>

        <!-- Featured Projects Grid (2 Columns, Compact, No Tags) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {pinnedProjects.map(project => {
            const hasDocs = projectsWithDocsSet.has(project.id);
            const { title, description, appStore, playStore, website } = project.data;

            return (
              <div class="group relative rounded-xl border border-border/20 bg-muted/10 p-4 sm:p-5 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-muted/10 hover:shadow-lg hover:shadow-accent/10 flex flex-col justify-between">
                <div>
                  <!-- Card Header: Title & Badges -->
                  <div class="flex items-center justify-between gap-3 mb-2">
                    <h3 class="text-base sm:text-lg font-bold tracking-tight text-foreground group-hover:text-accent transition-colors">
                      <a href={`/progetti/${project.id}/`} class="focus-visible:outline-none">
                        <span class="absolute inset-0 rounded-xl z-0" aria-hidden="true"></span>
                        {title}
                      </a>
                    </h3>

                    {hasDocs && (
                      <a
                        href={`/progetti/${project.id}/docs/`}
                        class="relative z-10 inline-flex items-center gap-1.5 rounded-full border border-accent/40 bg-accent/15 px-2.5 py-0.5 text-xs font-firacode font-semibold text-accent hover:bg-accent hover:text-background transition-all shadow-xs shrink-0"
                        title="Apri la documentazione"
                      >
                        <span>Docs</span>
                        <span class="size-1.5 rounded-full bg-accent animate-pulse"></span>
                      </a>
                    )}
                  </div>

                  <!-- Description -->
                  <p class="text-xs text-foreground/65 leading-relaxed line-clamp-2 mb-3.5 select-text">
                    {description}
                  </p>
                </div>

                <!-- Footer: Actions Row -->
                <div class="pt-3 border-t border-border/20 flex items-center justify-between gap-2 relative z-10 text-xs">
                  <div class="flex items-center gap-1.5">
                    {appStore && (
                      <a
                        href={appStore}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md border border-border/30 bg-muted/20 font-medium text-xs text-foreground/65 hover:border-accent/40 hover:text-accent transition-colors"
                        title="Vedi su App Store"
                      >
                        <svg class="size-3" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                        <span>App Store</span>
                      </a>
                    )}
                    {playStore && (
                      <a
                        href={playStore}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md border border-border/30 bg-muted/20 font-medium text-xs text-foreground/65 hover:border-accent/40 hover:text-accent transition-colors"
                        title="Vedi su Google Play"
                      >
                        <span>Play Store</span>
                      </a>
                    )}
                    {website && (
                      <a
                        href={website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md border border-border/30 bg-muted/20 font-medium text-xs text-foreground/65 hover:border-accent/40 hover:text-accent transition-colors"
                        title="Visita sito web"
                      >
                        <span>Web</span>
                      </a>
                    )}
                  </div>

                  <a
                    href={`/progetti/${project.id}/`}
                    class="font-semibold text-accent flex items-center gap-1 hover:translate-x-0.5 transition-transform"
                  >
                    <span>Dettagli</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- ═══════════════════ KNOWLEDGE BASE & DOCS BANNER ═══════════════════ -->
    <section class="pb-10">
      <div class="relative overflow-hidden rounded-3xl border border-border/30 bg-muted/10 p-6 sm:p-8 backdrop-blur-md transition-all hover:border-accent/30">
        <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
          <div class="max-w-xl">
            <div class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-firacode text-xs text-accent font-semibold mb-3">
              <span>📖 Knowledge Base & Guide</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">
              Documentazione & Wiki per ogni Progetto
            </h2>
            <p class="mt-2 text-sm text-foreground/65 leading-relaxed">
              Esplora i manuali d'uso, le guide all'installazione, i dettagli sui formati supportati e le scorciatoie da tastiera per tutte le applicazioni e utility.
            </p>
          </div>
          <a
            href="/docs/"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-accent bg-accent px-6 py-3.5 text-sm font-bold text-background shadow-lg shadow-accent/20 transition-all duration-200 hover:opacity-95 hover:scale-[1.02] shrink-0"
          >
            <span>Sfoglia la Documentazione</span>
            <IconArrowRight class="size-4 rtl:-rotate-180" />
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ RECENT POSTS ═══════════════════ -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-6 pb-12">
          <!-- Section Header -->
          <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
              <div class="inline-flex items-center gap-2 font-firacode text-xs text-accent font-semibold mb-1">
                <span class="size-2 rounded-full bg-accent animate-pulse"></span>
                <span>BLOG & ARTICOLI</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
                {t("home.recent")}
              </h2>
            </div>
            <a
              href="/posts/"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline shrink-0"
            >
              <span>Tutti gli articoli ({recentPosts.length})</span>
              <IconArrowRight class="size-3.5 rtl:-rotate-180" />
            </a>
          </div>

          <HomeRecentPosts posts={recentPosts.slice(0, SITE.postPerIndex)} />
        </section>
      )
    }
  </main>
  <Footer />
</Layout>


<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
