---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { SITE } from "@/config";

const projects = (await getCollection("projectsEn", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());
---

<Layout title={`Projects | ${SITE.title}`} description="Apps and websites I have built.">
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-4">
    <div class="page-hero" data-page-hero>
      <div class="aurora-mouse" data-hero-mouse></div>
      <div class="relative z-10 max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-firacode text-xs font-semibold text-accent mb-3.5">
          <span class="size-2 rounded-full bg-accent animate-pulse"></span>
          <span>PORTFOLIO & NATIVE SOFTWARE</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground leading-[1.1] mb-3">
          <span class="glow-text">Projects</span>
        </h1>
        <p class="text-sm sm:text-base text-foreground/70 leading-relaxed max-w-xl">
          macOS software, mobile applications, and web tools built with privacy-by-design, local-first architecture, and clean code.
        </p>
        <div class="mt-5 pt-5 border-t border-border/15 flex flex-wrap items-center gap-3 text-xs font-firacode text-foreground/60">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
            <span class="size-1.5 rounded-full bg-accent"></span>
            <span>{projects.length} Published Projects</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
            <span class="size-1.5 rounded-full bg-emerald-400"></span>
            <span>100% Free Forever</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
            <span class="size-1.5 rounded-full bg-sky-400"></span>
            <span>Zero Ads & Tracking</span>
          </span>
        </div>
      </div>
    </div>

    {projects.length > 0 ? (
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 [&>li]:my-0">
        {projects.map(project => (
          <ProjectCard
            project={project}
            href={`/en/projects/${project.id}/`}
            lang="en"
          />
        ))}
      </ul>
    ) : (
      <p class="mt-8 text-foreground/60 italic">No projects yet. Coming soon.</p>
    )}
  </main>
  <Footer />
</Layout>
