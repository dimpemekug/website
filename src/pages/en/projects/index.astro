---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import PageHero from "@/components/PageHero.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { SITE } from "@/config";

const projects = (await getCollection("projectsEn", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());
---

<Layout title={`Projects | ${SITE.title}`} description="Apps and websites I have built.">
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-4">
    <PageHero variant="list" eyebrow="PORTFOLIO & NATIVE SOFTWARE" title="Projects">
      <Fragment slot="description">macOS software, mobile applications, and web tools built with privacy-by-design, local-first architecture, and clean code.</Fragment>
      <Fragment slot="stats">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
          <span class="size-1.5 rounded-full bg-accent"></span>
          <span>{projects.length} Published Projects</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
          <span class="size-1.5 rounded-full bg-emerald-400"></span>
          <span>100% Free Forever</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
          <span class="size-1.5 rounded-full bg-sky-400"></span>
          <span>Zero Ads & Tracking</span>
        </span>
      </Fragment>
    </PageHero>

    {projects.length > 0 ? (
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 [&>li]:my-0">
        {projects.map(project => (
          <ProjectCard
            project={project}
            href={`/en/projects/${project.id}/`}
            lang="en"
          />
        ))}
      </ul>
    ) : (
      <p class="mt-8 text-foreground/65 italic">No projects yet. Coming soon.</p>
    )}
  </main>
  <Footer />
</Layout>
