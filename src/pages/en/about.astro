---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const allProjects = (await getCollection("projectsEn", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());

const allDocs = await getCollection("docsEn", ({ data }) => !data.draft);
const projectsWithDocsSet = new Set(
  allDocs.map(d => d.data.project || d.id.split("/")[0])
);
---

<Layout
  title={`About | ${SITE.title}`}
  description="App and website developer, for the love of it. Apps born from real needs, always free and ad-free."
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-20">
    <!-- ═══════════════════ HERO PROFILE (Linear Modern Glass) ═══════════════════ -->
    <section class="relative pt-6 pb-14 overflow-hidden">
      <!-- Ambient spotlight glow -->
      <div class="pointer-events-none absolute -top-16 left-1/2 -translate-x-1/2 w-[650px] h-[300px] bg-gradient-to-b from-accent/20 via-indigo-500/10 to-transparent blur-3xl opacity-70" aria-hidden="true"></div>

      <div class="relative z-10 max-w-3xl">
        <!-- Status Pill -->
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3.5 py-1 text-xs font-firacode font-medium text-accent backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          <span>INDEPENDENT & NON-PROFIT</span>
        </div>

        <!-- Headline with Linear gradient -->
        <h1 class="hero-title text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-foreground leading-[1.1] mb-6">
          Clean code,<br />
          <span class="bg-gradient-to-r from-accent via-indigo-400 to-sky-400 bg-clip-text text-transparent">
            clear ideas and user respect.
          </span>
        </h1>

        <p class="text-base sm:text-lg text-foreground/80 leading-relaxed max-w-2xl">
          Welcome to my digital space. I'm <strong class="text-foreground font-semibold">{SITE.author}</strong>, a developer passionate about technology, design, and everything that's built with code. I build native apps and websites with meticulous care for user experience and data privacy.
        </p>

        <!-- Highlights Bar -->
        <div class="mt-8 pt-6 border-t border-border/20 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-foreground/45 font-firacode">
          <span class="flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-accent"></span>
            <span>{allProjects.length} Published Projects</span>
          </span>
          <span class="flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-emerald-400"></span>
            <span>100% Free & No Ads</span>
          </span>
          <span class="flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-sky-400"></span>
            <span>Zero Tracking & Local-First</span>
          </span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ CORE VALUES / PHILOSOPHY BENTO GRID ═══════════════════ -->
    <section class="pb-16">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 font-firacode text-xs text-accent font-semibold mb-1">
          <span class="size-2 rounded-full bg-accent animate-pulse"></span>
          <span>CORE VALUES</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
          Why I build software
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- Card 1: Fun & Passion -->
        <div class="rounded-2xl border border-border/20 bg-muted/10 p-6 backdrop-blur-md transition-all duration-300 hover:border-accent/40 hover:bg-muted/10">
          <div class="size-10 rounded-xl bg-accent/10 border border-accent/30 flex items-center justify-center text-accent mb-4">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-foreground mb-2">Coding purely for fun</h3>
          <p class="text-sm text-foreground/65 leading-relaxed">
            It's not my commercial livelihood or how I make a living: it's how I choose to spend my free time. Between an idea to experiment with, a problem to solve, and the quiet satisfaction of seeing a stream of bytes turn into a tool that just works.
          </p>
        </div>

        <!-- Card 2: Real Needs & Dogfooding -->
        <div class="rounded-2xl border border-border/20 bg-muted/10 p-6 backdrop-blur-md transition-all duration-300 hover:border-accent/40 hover:bg-muted/10">
          <div class="size-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-4">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-foreground mb-2">Born from real daily needs</h3>
          <p class="text-sm text-foreground/65 leading-relaxed">
            Monitoring household utility usage, cataloging watch collections, extracting compressed archives without disk clutter, correcting EXIF timestamps or trimming video without re-encoding: every app was created because existing tools were bloated or invaded privacy. I'm the primary daily user of everything I make.
          </p>
        </div>

        <!-- Card 3: Always Free -->
        <div class="rounded-2xl border border-border/20 bg-muted/10 p-6 backdrop-blur-md transition-all duration-300 hover:border-accent/40 hover:bg-muted/10">
          <div class="size-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 mb-4">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-foreground mb-2">100% Free: No Subscriptions, Zero Ads</h3>
          <p class="text-sm text-foreground/65 leading-relaxed">
            My apps are and will always remain completely free. No in-app purchases, no paywalls, and no advertisements. They don't need to chase metrics, appease investors, or monetize attention: their sole goal is to perform their job reliably and stay out of the way.
          </p>
        </div>

        <!-- Card 4: Privacy & Local-First Architecture -->
        <div class="rounded-2xl border border-border/20 bg-muted/10 p-6 backdrop-blur-md transition-all duration-300 hover:border-accent/40 hover:bg-muted/10">
          <div class="size-10 rounded-xl bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400 mb-4">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-foreground mb-2">Privacy by Design & Zero-Network</h3>
          <p class="text-sm text-foreground/65 leading-relaxed">
            Without a business model to feed, there is zero reason to collect telemetry or personal data. Wherever possible, apps run with sandbox restrictions: local databases, on-device encryption, and syncing exclusively through secure personal accounts such as Apple iCloud.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ SKILLS & TECH STACK ═══════════════════ -->
    <section class="pb-16">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 font-firacode text-xs text-accent font-semibold mb-1">
          <span class="size-2 rounded-full bg-accent animate-pulse"></span>
          <span>SKILLS & STACK</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
          What I build and the tools I use
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Tech 1 -->
        <div class="rounded-2xl border border-border/20 bg-muted/10 p-5 backdrop-blur-md">
          <span class="text-xs font-firacode text-accent font-semibold uppercase">macOS & iOS</span>
          <h4 class="text-base font-bold text-foreground mt-1 mb-2">Swift & SwiftUI</h4>
          <p class="text-xs text-foreground/65 leading-relaxed">
            Native macOS software optimized for Apple Silicon, integrated with QuickLook, Finder context menus, and secure local storage.
          </p>
        </div>

        <!-- Tech 2 -->
        <div class="rounded-2xl border border-border/20 bg-muted/10 p-5 backdrop-blur-md">
          <span class="text-xs font-firacode text-sky-400 font-semibold uppercase">Mobile Cross-Platform</span>
          <h4 class="text-base font-bold text-foreground mt-1 mb-2">Flutter & Dart</h4>
          <p class="text-xs text-foreground/65 leading-relaxed">
            High-performance cross-platform apps for iPhone, iPad, and Android with 120Hz smooth animations and fluid UI.
          </p>
        </div>

        <!-- Tech 3 -->
        <div class="rounded-2xl border border-border/20 bg-muted/10 p-5 backdrop-blur-md">
          <span class="text-xs font-firacode text-purple-400 font-semibold uppercase">Modern Web</span>
          <h4 class="text-base font-bold text-foreground mt-1 mb-2">Astro & TypeScript</h4>
          <p class="text-xs text-foreground/65 leading-relaxed">
            Blazing-fast websites with component island architectures, Markdown/MDX content, and zero superfluous JavaScript payloads.
          </p>
        </div>

        <!-- Tech 4 -->
        <div class="rounded-2xl border border-border/20 bg-muted/10 p-5 backdrop-blur-md">
          <span class="text-xs font-firacode text-emerald-400 font-semibold uppercase">CMS & Backend</span>
          <h4 class="text-base font-bold text-foreground mt-1 mb-2">Plain PHP & WordPress</h4>
          <p class="text-xs text-foreground/65 leading-relaxed">
            Custom editorial themes built for digital news outlets, written in clean vanilla PHP without sluggish plugins or heavy frameworks.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ APPLICATION PORTFOLIO ═══════════════════ -->
    <section class="pb-16">
      <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 font-firacode text-xs text-accent font-semibold mb-1">
            <span class="size-2 rounded-full bg-accent animate-pulse"></span>
            <span>PORTFOLIO</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
            All published applications
          </h2>
          <p class="text-sm text-foreground/65 mt-1">
            Available completely free on the Mac App Store, Google Play, or via direct download.
          </p>
        </div>
        <a
          href="/en/projects/"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline shrink-0"
        >
          <span>Go to projects section ({allProjects.length})</span>
          <IconArrowRight class="size-3.5 rtl:-rotate-180" />
        </a>
      </div>

      <!-- 2 Columns Grid of Projects -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {allProjects.map(project => {
          const hasDocs = projectsWithDocsSet.has(project.id);
          const primaryTag = project.data.tags[0] ?? "App";

          return (
            <div class="group relative rounded-xl border border-border/20 bg-background/50 p-4.5 backdrop-blur-md transition-all duration-200 hover:border-accent/40 hover:bg-muted/10 flex items-start justify-between gap-4">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="text-xs font-firacode px-1.5 py-0.5 rounded border border-border/30 bg-muted/20 text-foreground/65">
                    {primaryTag}
                  </span>
                  {hasDocs && (
                    <span class="text-xs font-firacode px-1.5 py-0.5 rounded border border-accent/30 bg-accent/10 text-accent font-medium">
                      Docs
                    </span>
                  )}
                </div>
                <h3 class="text-base font-bold text-foreground group-hover:text-accent transition-colors truncate">
                  <a href={`/en/projects/${project.id}/`} class="focus-visible:outline-none">
                    <span class="absolute inset-0 rounded-xl" aria-hidden="true"></span>
                    {project.data.title}
                  </a>
                </h3>
                <p class="text-xs text-foreground/65 line-clamp-2 mt-1 leading-relaxed">
                  {project.data.description}
                </p>
              </div>

              <div class="relative z-10 shrink-0 self-center">
                <span class="size-8 rounded-lg border border-border/30 bg-muted/10 group-hover:border-accent/40 group-hover:bg-accent/15 flex items-center justify-center text-foreground/45 group-hover:text-accent transition-all">
                  <IconArrowRight class="size-3.5 rtl:-rotate-180 group-hover:translate-x-0.5 transition-transform" />
                </span>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- ═══════════════════ CONTACT & CHANNELS ═══════════════════ -->
    <section class="pb-8">
      <div class="rounded-3xl border border-border/20 bg-muted/10 p-8 backdrop-blur-md relative overflow-hidden">
        <div class="max-w-xl">
          <div class="inline-flex items-center gap-2 font-firacode text-xs text-accent font-semibold mb-2">
            <span class="size-2 rounded-full bg-accent animate-pulse"></span>
            <span>GET IN TOUCH</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground mb-3">
            Have an idea, an issue or feedback?
          </h2>
          <p class="text-sm text-foreground/65 leading-relaxed mb-6">
            Whether it's a feature request for an existing app, a bug report, or a technical inquiry, feel free to reach out anytime.
          </p>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="mailto:dimpemekug.app@gmail.com"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-accent text-background text-sm font-semibold shadow-lg shadow-accent/20 hover:opacity-95 hover:scale-[1.02] transition-all"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>dimpemekug.app@gmail.com</span>
            </a>

            <a
              href="https://github.com/dimpemekug"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-border/30 bg-muted/20 text-sm font-semibold text-foreground hover:border-accent/40 hover:bg-muted/20 transition-all"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>GitHub (@dimpemekug)</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Hero title shimmer ── */
  .hero-title {
    background: linear-gradient(
      135deg,
      var(--accent) 0%,
      color-mix(in oklab, var(--accent) 50%, var(--foreground)) 20%,
      var(--foreground) 35%,
      var(--foreground) 65%,
      color-mix(in oklab, var(--accent) 50%, var(--foreground)) 80%,
      var(--accent) 100%
    );
    background-size: 250% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 6s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%,
    100% {
      background-position: 0% center;
    }
    50% {
      background-position: 100% center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title {
      animation: none;
      background: none;
      -webkit-text-fill-color: var(--foreground);
    }
  }
</style>
