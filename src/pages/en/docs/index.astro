---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";

const allDocs = await getCollection("docsEn", ({ data }) => !data.draft);
const allProjects = await getCollection("projectsEn", ({ data }) => !data.draft);

const projectMap = new Map(allProjects.map(p => [p.id, p]));

// Group docs by project
const projectsWithDocs = Array.from(
  new Set(allDocs.map(d => d.data.project || d.id.split("/")[0]))
);

const projectDocGroups = projectsWithDocs.map(projectId => {
  const project = projectMap.get(projectId);
  const docs = allDocs
    .filter(d => (d.data.project || d.id.split("/")[0]) === projectId)
    .sort((a, b) => a.data.order - b.data.order);

  return {
    id: projectId,
    title: project ? project.data.title : projectId,
    description: project ? project.data.description : "",
    tags: project ? project.data.tags : [],
    docsCount: docs.length,
    docs,
  };
});
---

<Layout
  title={`Documentation & Project Wiki | ${SITE.title}`}
  description="Technical guides, wiki, user manuals and configuration references for all apps and software projects."
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pt-4 pb-20">
    <!-- Hero (Linear Modern Glass) -->
    <div class="page-hero relative overflow-hidden rounded-3xl border border-border/25 bg-muted/8 p-8 sm:p-10 backdrop-blur-md mb-10">
      <div class="pointer-events-none absolute -top-16 left-1/2 -translate-x-1/2 w-[500px] h-[200px] bg-gradient-to-b from-accent/20 to-transparent blur-3xl opacity-70" aria-hidden="true"></div>
      <div class="relative z-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-firacode text-xs font-semibold text-accent mb-3.5">
          <span class="size-2 rounded-full bg-accent animate-pulse"></span>
          <span>OFFICIAL KNOWLEDGE BASE & GUIDES</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground leading-[1.1] mb-3">
          <span class="glow-text">Documentation & Wiki</span>
        </h1>
        <p class="text-sm sm:text-base text-foreground/70 leading-relaxed max-w-xl">
          User manuals, installation instructions, privacy insights, and keyboard shortcuts for all software and native apps.
        </p>
        <div class="mt-5 pt-5 border-t border-border/15 flex flex-wrap items-center gap-3 text-xs font-firacode text-foreground/60">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
            <span class="size-1.5 rounded-full bg-accent"></span>
            <span>{projectsWithDocs.length} Projects with Wiki</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
            <span class="size-1.5 rounded-full bg-emerald-400"></span>
            <span>{allDocs.length} Articles & Guides</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Project Docs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projectDocGroups.map(p => (
        <div class="group relative rounded-2xl border border-border/25 bg-muted/5 p-6 hover:border-accent/40 hover:bg-muted/10 transition-all duration-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-2xl font-bold text-foreground group-hover:text-accent transition-colors">
                {p.title}
              </h2>
              <span class="text-xs font-firacode px-2 py-0.5 rounded-md border border-border/30 bg-muted/15 text-foreground/70">
                {p.docsCount} {p.docsCount === 1 ? "guide" : "guides"}
              </span>
            </div>

            {p.description && (
              <p class="text-sm text-foreground/70 line-clamp-3 mb-5 leading-relaxed">
                {p.description}
              </p>
            )}

            <!-- Quick list of guides -->
            <ul class="space-y-1.5 mb-6 text-xs text-foreground/60 border-t border-border/15 pt-4">
              {p.docs.slice(0, 4).map(d => {
                const docSlug = d.id === p.id || d.id === `${p.id}/index`
                  ? "index"
                  : (d.id.includes("/") ? d.id.split("/").slice(1).join("/") : d.id);
                const docHref = docSlug === "index" ? `/en/projects/${p.id}/docs/` : `/en/projects/${p.id}/docs/${docSlug}/`;
                return (
                  <li>
                    <a href={docHref} class="hover:text-accent flex items-center gap-1.5 transition-colors">
                      <span class="text-accent/50 font-firacode">→</span>
                      <span>{d.data.title}</span>
                    </a>
                  </li>
                );
              })}
              {p.docs.length > 4 && (
                <li class="text-[11px] text-foreground/40 italic">
                  + {p.docs.length - 4} more pages...
                </li>
              )}
            </ul>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-border/20">
            <a
              href={`/en/projects/${p.id}/`}
              class="text-xs text-foreground/50 hover:text-foreground transition-colors"
            >
              App details
            </a>
            <a
              href={`/en/projects/${p.id}/docs/`}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline"
            >
              <span>Explore Docs</span>
              <span class="font-firacode">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
