---
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import PageHero from "@/components/PageHero.astro";
import { SITE } from "@/config";
---

<Layout title={`Search | ${SITE.title}`} noindex={true} nofollow={true}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <PageHero variant="list" eyebrow="FULL-TEXT SEARCH" title="Search">
      <Fragment slot="description">Find any article, technical tutorial, or project note on the blog.</Fragment>
    </PageHero>
    <div id="search" class="premium-search mt-4"></div>
  </main>
  <Footer />
</Layout>

<script>
  import { PagefindUI } from "@pagefind/default-ui";
  window.addEventListener("DOMContentLoaded", () => {
    new PagefindUI({
      element: "#search",
      showSubResults: true,
      showImages: false,
    });
    const input = document.querySelector<HTMLInputElement>(".pagefind-ui__search-input");
    if (input) {
      input.placeholder = "Search posts...";
      input.focus();
    }
  });
</script>
