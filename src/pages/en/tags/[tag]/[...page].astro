---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const [blogPosts, galleryPosts] = await Promise.all([
    getCollection("blogEn"),
    SITE.showGalleries && SITE.showGalleriesInIndex
      ? getCollection("galleries")
      : Promise.resolve([]),
  ]);
  const posts = [...blogPosts, ...galleryPosts];
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);
    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;

const tagOgImage = `/tags/${tag}/og.png`;

const metaTitle = page.currentPage > 1
  ? `Tag: ${tagName} (Page ${page.currentPage} of ${page.lastPage}) | ${SITE.title}`
  : `Tag: ${tagName} | ${SITE.title}`;

const tagDescription = page.currentPage > 1
  ? `All articles tagged with "${tagName}" on ${SITE.title} (Page ${page.currentPage} of ${page.lastPage}).`
  : `All articles tagged with "${tagName}" on ${SITE.title}.`;

const prevURL = page.url.prev
  ? new URL(page.url.prev.replace("/tags/", "/en/tags/"), SITE.website).toString()
  : undefined;
const nextURL = page.url.next
  ? new URL(page.url.next.replace("/tags/", "/en/tags/"), SITE.website).toString()
  : undefined;
---

<Layout title={metaTitle} description={tagDescription} ogImage={tagOgImage} prev={prevURL} next={nextURL}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">

    <!-- Hero (Linear Modern Glass) -->
    <div class="page-hero" data-page-hero>
      <div class="aurora-mouse" data-hero-mouse></div>
      <div class="relative z-10 max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-firacode text-xs font-semibold text-accent mb-3.5">
          <span class="size-2 rounded-full bg-accent animate-pulse"></span>
          <span>TOPIC TAG</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground leading-[1.1] mb-3">
          <span class="glow-text" transition:name={tag}>#{tagName}</span>
        </h1>
        <p class="text-sm sm:text-base text-foreground/70 leading-relaxed max-w-xl">
          All published articles and technical notes filed under #{tagName}.
        </p>
        <div class="mt-5 pt-5 border-t border-border/15 flex flex-wrap items-center gap-3 text-xs font-firacode text-foreground/60">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
            <span class="size-1.5 rounded-full bg-accent"></span>
            <span>{page.total} {page.total === 1 ? "article" : "articles"}</span>
          </span>
          {page.lastPage > 1 && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border/30 bg-muted/20">
              <span>Page {page.currentPage}/{page.lastPage}</span>
            </span>
          )}
        </div>
      </div>
    </div>

    <!-- Posts -->
    {page.data.length === 0 ? (
      <p class="py-12 text-center opacity-50">No posts found.</p>
    ) : (
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-5 [&>li]:my-0">
        {page.data.map((data, index) => (
          <Card
            {...data}
            loading={index < 3 ? "eager" : "lazy"}
            fetchpriority={index < 3 ? "high" : "auto"}
          />
        ))}
      </ul>
    )}

    <Pagination {page} />
  </main>
  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<style>
  .tag-eyebrow {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    opacity: 0.7;
    margin-bottom: 0.25rem;
  }
</style>
