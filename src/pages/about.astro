---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const allProjects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());

const allDocs = await getCollection("docs", ({ data }) => !data.draft);
const projectsWithDocsSet = new Set(
  allDocs.map(d => d.data.project || d.id.split("/")[0])
);
---

<Layout
  title={`Chi sono | ${SITE.title}`}
  description="Sviluppatore di app e siti web per passione. App nate da esigenze reali, sempre gratuite e senza pubblicità."
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-20">
    <!-- ═══════════════════ HERO PROFILE (Linear Modern Glass) ═══════════════════ -->
    <section class="relative pt-6 pb-14 overflow-hidden">
      <!-- Ambient spotlight glow -->
      <div class="pointer-events-none absolute -top-16 left-1/2 -translate-x-1/2 w-[650px] h-[300px] bg-gradient-to-b from-accent/20 via-indigo-500/10 to-transparent blur-3xl opacity-70" aria-hidden="true"></div>

      <div class="relative z-10 max-w-3xl">
        <!-- Status Pill -->
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3.5 py-1 text-xs font-firacode font-medium text-accent backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          <span>INDIPENDENTE & SENZA SCOPO DI LUCRO</span>
        </div>

        <!-- Headline with Linear gradient -->
        <h1 class="hero-title text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-foreground leading-[1.1] mb-6">
          Codice pulito,<br />
          <span class="bg-gradient-to-r from-accent via-indigo-400 to-sky-400 bg-clip-text text-transparent">
            idee chiare e rispetto per l'utente.
          </span>
        </h1>

        <p class="text-base sm:text-lg text-foreground/80 leading-relaxed max-w-2xl">
          Benvenuto nel mio spazio digitale. Sono <strong class="text-foreground font-semibold">{SITE.author}</strong>, sviluppatore appassionato di tecnologia, design e tutto ciò che si costruisce con il codice. Creo app native e siti web con cura meticolosa per l'esperienza d'uso e la privacy dei dati.
        </p>

        <!-- Highlights Bar -->
        <div class="mt-8 pt-6 border-t border-border/20 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-foreground/50 font-firacode">
          <span class="flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-accent"></span>
            <span>{allProjects.length} Progetti Pubblicati</span>
          </span>
          <span class="flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-emerald-400"></span>
            <span>100% Gratuite & No Ads</span>
          </span>
          <span class="flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-sky-400"></span>
            <span>Zero Tracciamento & Local-First</span>
          </span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ CORE VALUES / FILOSOFIA BENTO GRID ═══════════════════ -->
    <section class="pb-16">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 font-firacode text-xs text-accent font-semibold mb-1">
          <span class="size-2 rounded-full bg-accent animate-pulse"></span>
          <span>VALORI FONDAMENTALI</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
          Perché sviluppo software
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- Card 1: Passione & Divertimento -->
        <div class="rounded-2xl border border-border/25 bg-muted/8 p-6 backdrop-blur-md transition-all duration-300 hover:border-accent/40 hover:bg-muted/12">
          <div class="size-10 rounded-xl bg-accent/10 border border-accent/30 flex items-center justify-center text-accent mb-4">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-foreground mb-2">Programmare per puro divertimento</h3>
          <p class="text-sm text-foreground/70 leading-relaxed">
            Non è la mia professione commerciale né il mio modo di guadagnare: è il modo in cui scelgo di passare il mio tempo libero. Tra un'idea da sperimentare, un problema da risolvere e la soddisfazione di vedere un flusso di bit trasformarsi in uno strumento perfettamente funzionante.
          </p>
        </div>

        <!-- Card 2: Esigenze Reali & Dogfooding -->
        <div class="rounded-2xl border border-border/25 bg-muted/8 p-6 backdrop-blur-md transition-all duration-300 hover:border-accent/40 hover:bg-muted/12">
          <div class="size-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-4">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-foreground mb-2">Nate da esigenze quotidiane reali</h3>
          <p class="text-sm text-foreground/70 leading-relaxed">
            Monitorare i consumi domestici, catalogare gli orologi da collezione, estrarre archivi compressi senza sporcare il disco, correggere i metadati EXIF o tagliare video senza ricodifica: ogni applicazione nasce perché sul mercato mancava una soluzione semplice, pulita e privata. Il primo utente quotidiano sono io.
          </p>
        </div>

        <!-- Card 3: Sempre Gratuite -->
        <div class="rounded-2xl border border-border/25 bg-muted/8 p-6 backdrop-blur-md transition-all duration-300 hover:border-accent/40 hover:bg-muted/12">
          <div class="size-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 mb-4">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-foreground mb-2">100% Gratuite: Nessun Abbonamento, Zero Ads</h3>
          <p class="text-sm text-foreground/70 leading-relaxed">
            Le mie app sono e rimarranno sempre gratuite. Nessun acquisto in-app, nessun paywall e nessun banner pubblicitario. Non devono monetizzare l'attenzione di nessuno né fare numeri artificiali per algoritmi o investitori: devono semplicemente svolgere il loro compito nel miglior modo possibile.
          </p>
        </div>

        <!-- Card 4: Privacy & Architettura Local-First -->
        <div class="rounded-2xl border border-border/25 bg-muted/8 p-6 backdrop-blur-md transition-all duration-300 hover:border-accent/40 hover:bg-muted/12">
          <div class="size-10 rounded-xl bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400 mb-4">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-foreground mb-2">Privacy by Design & Zero-Network</h3>
          <p class="text-sm text-foreground/70 leading-relaxed">
            Non essendoci modelli di business da alimentare, non c'è alcun motivo di raccogliere dati. Dove possibile, i software operano con permessi di rete azzerati: database locali, cifratura sul dispositivo e sincronizzazione solo tramite account personali protetti come Apple iCloud.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ COMPETENZE & STACK TECNOLOGICO ═══════════════════ -->
    <section class="pb-16">
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 font-firacode text-xs text-accent font-semibold mb-1">
          <span class="size-2 rounded-full bg-accent animate-pulse"></span>
          <span>COMPETENZE & STACK</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
          Cosa sviluppo e con quali strumenti
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Tech 1 -->
        <div class="rounded-2xl border border-border/25 bg-muted/8 p-5 backdrop-blur-md">
          <span class="text-[11px] font-firacode text-accent font-semibold uppercase">macOS & iOS</span>
          <h4 class="text-base font-bold text-foreground mt-1 mb-2">Swift & SwiftUI</h4>
          <p class="text-xs text-foreground/70 leading-relaxed">
            Applicazioni native macOS ottimizzate per Apple Silicon, con QuickLook, menu contestuali del Finder e storage locale.
          </p>
        </div>

        <!-- Tech 2 -->
        <div class="rounded-2xl border border-border/25 bg-muted/8 p-5 backdrop-blur-md">
          <span class="text-[11px] font-firacode text-sky-400 font-semibold uppercase">Mobile Cross-Platform</span>
          <h4 class="text-base font-bold text-foreground mt-1 mb-2">Flutter & Dart</h4>
          <p class="text-xs text-foreground/70 leading-relaxed">
            App multi-piattaforma per iPhone, iPad e Android con performance a 120Hz e interfaccia utente fluida.
          </p>
        </div>

        <!-- Tech 3 -->
        <div class="rounded-2xl border border-border/25 bg-muted/8 p-5 backdrop-blur-md">
          <span class="text-[11px] font-firacode text-purple-400 font-semibold uppercase">Modern Web</span>
          <h4 class="text-base font-bold text-foreground mt-1 mb-2">Astro & TypeScript</h4>
          <p class="text-xs text-foreground/70 leading-relaxed">
            Siti web ultra-veloci ad alte prestazioni, con architettura a isole di componenti, Markdown/MDX e zero JavaScript superfluo.
          </p>
        </div>

        <!-- Tech 4 -->
        <div class="rounded-2xl border border-border/25 bg-muted/8 p-5 backdrop-blur-md">
          <span class="text-[11px] font-firacode text-emerald-400 font-semibold uppercase">CMS & Backend</span>
          <h4 class="text-base font-bold text-foreground mt-1 mb-2">PHP Puro & WordPress</h4>
          <p class="text-xs text-foreground/70 leading-relaxed">
            Temi editoriali personalizzati per testate giornalistiche, sviluppati in PHP puro senza framework pesanti o dipendenze lente.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ PORTFOLIO APPLICAZIONI & PROGETTI ═══════════════════ -->
    <section class="pb-16">
      <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 font-firacode text-xs text-accent font-semibold mb-1">
            <span class="size-2 rounded-full bg-accent animate-pulse"></span>
            <span>PORTFOLIO COMPLETO</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
            Tutte le applicazioni realizzate
          </h2>
          <p class="text-sm text-foreground/65 mt-1">
            Disponibili gratuitamente su Mac App Store, Google Play o tramite distribuzione diretta.
          </p>
        </div>
        <a
          href="/progetti/"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline shrink-0"
        >
          <span>Vai alla sezione progetti ({allProjects.length})</span>
          <IconArrowRight class="size-3.5 rtl:-rotate-180" />
        </a>
      </div>

      <!-- 2 Columns Grid of Projects -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {allProjects.map(project => {
          const hasDocs = projectsWithDocsSet.has(project.id);
          const primaryTag = project.data.tags[0] ?? "App";

          return (
            <div class="group relative rounded-xl border border-border/20 bg-background/50 p-4.5 backdrop-blur-md transition-all duration-200 hover:border-accent/40 hover:bg-muted/12 flex items-start justify-between gap-4">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="text-[10px] font-firacode px-1.5 py-0.5 rounded border border-border/30 bg-muted/20 text-foreground/60">
                    {primaryTag}
                  </span>
                  {hasDocs && (
                    <span class="text-[10px] font-firacode px-1.5 py-0.5 rounded border border-accent/30 bg-accent/10 text-accent font-medium">
                      Docs
                    </span>
                  )}
                </div>
                <h3 class="text-base font-bold text-foreground group-hover:text-accent transition-colors truncate">
                  <a href={`/progetti/${project.id}/`} class="focus-visible:outline-none">
                    <span class="absolute inset-0 rounded-xl" aria-hidden="true"></span>
                    {project.data.title}
                  </a>
                </h3>
                <p class="text-xs text-foreground/65 line-clamp-2 mt-1 leading-relaxed">
                  {project.data.description}
                </p>
              </div>

              <div class="relative z-10 shrink-0 self-center">
                <span class="size-8 rounded-lg border border-border/30 bg-muted/10 group-hover:border-accent/50 group-hover:bg-accent/15 flex items-center justify-center text-foreground/50 group-hover:text-accent transition-all">
                  <IconArrowRight class="size-3.5 rtl:-rotate-180 group-hover:translate-x-0.5 transition-transform" />
                </span>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- ═══════════════════ CONTATTI & CANALI ═══════════════════ -->
    <section class="pb-8">
      <div class="rounded-3xl border border-border/25 bg-muted/8 p-8 backdrop-blur-md relative overflow-hidden">
        <div class="max-w-xl">
          <div class="inline-flex items-center gap-2 font-firacode text-xs text-accent font-semibold mb-2">
            <span class="size-2 rounded-full bg-accent animate-pulse"></span>
            <span>SCRIVIMI</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground mb-3">
            Hai un'idea, un problema o un suggerimento?
          </h2>
          <p class="text-sm text-foreground/70 leading-relaxed mb-6">
            Che si tratti di una proposta per una nuova app, della segnalazione di un bug o di una richiesta tecnica, puoi contattarmi liberamente sui canali ufficiali.
          </p>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="mailto:dimpemekug.app@gmail.com"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-accent text-background text-sm font-semibold shadow-lg shadow-accent/20 hover:opacity-95 hover:scale-[1.02] transition-all"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>dimpemekug.app@gmail.com</span>
            </a>

            <a
              href="https://github.com/dimpemekug"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-border/40 bg-muted/15 text-sm font-semibold text-foreground hover:border-accent/40 hover:bg-muted/25 transition-all"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>GitHub (@dimpemekug)</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Hero title shimmer ── */
  .hero-title {
    background: linear-gradient(
      135deg,
      var(--accent) 0%,
      color-mix(in oklab, var(--accent) 50%, var(--foreground)) 20%,
      var(--foreground) 35%,
      var(--foreground) 65%,
      color-mix(in oklab, var(--accent) 50%, var(--foreground)) 80%,
      var(--accent) 100%
    );
    background-size: 250% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 6s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%,
    100% {
      background-position: 0% center;
    }
    50% {
      background-position: 100% center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title {
      animation: none;
      background: none;
      -webkit-text-fill-color: var(--foreground);
    }
  }
</style>
